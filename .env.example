# ==============================================================================
# KisanRoute environment variable template
# Copy to a private .env file locally. Never commit real credentials.
# ==============================================================================
#
# Flask session security (generate a unique random value for each environment)
KISAN_ROUTE_SECRET_KEY=replace-with-a-long-random-secret

# AI provider
GEMINI_API_KEY=

# Supabase project API settings (only if the application feature uses Supabase APIs)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# PostgreSQL connection for Flask-SQLAlchemy.
# For Vercel/serverless, use the Supabase Transaction Pooler URI.
# Keep the URI private; it contains the database password.
# Set this separately in Vercel's Preview/Staging environment.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Owner-only Guardian controls (set only in the private secret manager)
OWNER_PIN=
OWNER_PHONE=
OWNER_TOKEN=

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MANDI_API_KEY=
MANDI_API_HOST=
MANDI_API_URL=
OPENROUTESERVICE_KEY=
WHATSAPP_RECEIVER_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
