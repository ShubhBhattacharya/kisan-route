# ==============================================================================
# KisanRoute Environment Variables & API Configuration
# ==============================================================================

# 1. Flask Security Key
KISAN_ROUTE_SECRET_KEY=kisan-route-prod-secure-token-987654321

# 2. AI Brain (Google Gemini API) - Currently Integrated
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Supabase SQL & PostgreSQL Database (Integrated)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Direct PostgreSQL URI (from Supabase Settings -> Database -> Connection String):
# SUPABASE_DB_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 4. Google Maps Platform (Directions, Places, Geocoding)
# GOOGLE_MAPS_API_KEY=AIzaSy...

# 5. SMS / OTP Gateway (Fast2SMS / MSG91)
# SMS_API_KEY=...
# SMS_SENDER_ID=KISANR

# 6. Online Payment (Razorpay Test or Live Keys)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# 7. Cloud Photo Storage (Cloudinary - Integrated)
CLOUDINARY_CLOUD_NAME=lyfr5gxb
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 8. Mandi Bhav & Live Market Prices (RapidAPI / Agmarknet - Integrated)
MANDI_API_KEY=your_rapidapi_mandi_key
# MANDI_API_HOST=your_mandi_api_host.p.rapidapi.com
# MANDI_API_URL=https://your_mandi_api_host.p.rapidapi.com/prices
