# ==============================================================================
# KisanRoute Environment Variables & API Configuration
# ==============================================================================

# 1. Flask Security Key
KISAN_ROUTE_SECRET_KEY=kisan-route-prod-secure-token-987654321

# 2. AI Brain (Google Gemini API) - Currently Integrated
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Production PostgreSQL Database (Optional - defaults to SQLite in local/tmp)
# KISAN_ROUTE_DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# 4. Google Maps Platform (Directions, Places, Geocoding)
# GOOGLE_MAPS_API_KEY=AIzaSy...

# 5. SMS / OTP Gateway (Fast2SMS / MSG91)
# SMS_API_KEY=...
# SMS_SENDER_ID=KISANR

# 6. Online Payment (Razorpay Test or Live Keys)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# 7. Cloud Photo Storage (Cloudinary)
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
